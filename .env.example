# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Browser Supabase (defaults to SUPABASE_* if omitted)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Auth
SESSION_SECRET=change-me-in-production

# ViciDial
VICIDIAL_USER=your_vicidial_user
VICIDIAL_PASS=your_vicidial_pass

# ForthCRM
FORTH_API_KEY=your_forth_api_key
# Optional fallback
FORTH_CLIENT_ID=
FORTH_CLIENT_SECRET=

# Gmail (shared mailbox OAuth / service account)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Google Sheets (supervisor log)
GOOGLE_SHEETS_CLIENT_EMAIL=
GOOGLE_SHEETS_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=

# Google Sheets (Master Master report)
GOOGLE_SHEETS_MASTER_SPREADSHEET_ID=
# Optional: override the default sheet range (default: Results!A1:L1000)
GOOGLE_SHEETS_MASTER_RANGE=

# Public sync endpoint
SYNC_SECRET=shared-secret-for-cron

# Thresholds
THRESHOLD_OVERDUE=30
